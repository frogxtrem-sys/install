#!/data/data/com.termux/files/usr/bin/bash

# 1. Configurações de Sistema (O SEGREDO DA ESTABILIDADE)
echo "⚡ Otimizando Android para Farm Pesado..."
su -c "wm density 160; settings put global window_animation_scale 0.0; settings put global transition_animation_scale 0.0"
su -c "settings put global settings_enable_monitor_phantom_procs false"
su -c "settings put global maximize_running_process_limit 100"
# Trava a CPU no máximo para evitar lag nos clones
su -c "echo performance > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"

# 2. Restauração do Ambiente Python
echo "📦 Restaurando ambiente Python pré-configurado..."
pkg update -y && pkg install wget tar axel procps -y
cd /data/data/com.termux/files
wget -q "https://github.com/frogxtrem-sys/clones/releases/download/v1/termux_backup.tar.gz" -O backup.tar.gz
tar -xzf backup.tar.gz
chmod -R 755 usr/bin/*
rm backup.tar.gz

# 3. Configurando Teclado Gboard (Sem atrapalhar o script)
echo "⌨️ Configurando Gboard..."
URL_GBOARD="https://github.com/frogxtrem-sys/clones/releases/download/v1/Gboard.apk"
wget -q $URL_GBOARD -O $HOME/gboard.apk
su -c "pm install -r $HOME/gboard.apk && ime enable com.google.android.inputmethod.latin/.android.inputmethod.latin.LatinIME && ime set com.google.android.inputmethod.latin/.android.inputmethod.latin.LatinIME"
rm $HOME/gboard.apk

# 4. Instalação dos Clones (4 contas automáticas)
echo "🚀 Iniciando Downloads Acelerados dos Clones..."
for i in {1..4}; do
    echo "📦 Baixando e Instalando Clone $i..."
    axel -n 10 -a "https://github.com/frogxtrem-sys/clones/releases/download/v1/clone$i.apk" -o $HOME/c$i.apk
    su -c "pm install -r $HOME/c$i.apk"
    rm $HOME/c$i.apk
done

# 5. Configuração do Auto-Start (Boot Automático)
echo "⚙️ Automatizando o Auto-Start (Boot)..."
mkdir -p ~/.termux/boot
cat <<EOF > ~/.termux/boot/start_farm.sh
#!/data/data/com.termux/files/usr/bin/sh
# 1. Garante que o Termux não durma
termux-wake-lock

# 2. Espera o sistema carregar (30s é pouco para o VMOS, pus 45s)
sleep 45

# 3. Comandos de Performance e Root
su -c "settings put global settings_enable_monitor_phantom_procs false"
su -c "wm density 160"

# 4. ENTRAR NA PASTA CORRETA (Verifique se é 'principal' ou 'Shouko.dev')
cd /data/data/com.termux/files/home/principal

# 5. RODAR O PYTHON (O '&' no final é opcional, mas ajuda a não travar o boot)
python3 2main.py --auto-start
EOF
chmod +x ~/.termux/boot/start_farm.sh

# 6. Preparação do Comando Curto 'go'
echo "cd /data/data/com.termux/files/home/principal && python3 2main.py" > /data/data/com.termux/files/usr/bin/go
chmod +x /data/data/com.termux/files/usr/bin/go

# 7. Execução do Projeto
echo "✅ TUDO PRONTO! O comando 'go' e o Auto-Boot foram configurados."
cd $HOME
rm -rf principal
git clone https://github.com/frogxtrem-sys/principal
# ... (depois de clonar o principal)
cd principal
echo "🐍 Instalando dependências do arquivo requirements..."
pip install -r requirements.txt

# Agora o motor vai girar sem engasgar
python 2main.py
